---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import AboutSection from "../../components/sections/AboutSection.astro";
import ServicesSection from "../../components/sections/ServicesSection.astro";
import ProjectsSection from "../../components/sections/ProjectsSection.astro";
import ReviewsSection from "../../components/sections/ReviewsSection.astro";
import ContactSection from "../../components/sections/ContactSection.astro";
import ContactDrawer from "../../components/ui/ContactDrawer.tsx";
import TravelingGlow from "../../components/ui/TravelingGlow.astro";
---

<MainLayout
  lang="es"
  title="CHRod - Desarrollador Web"
  description="Desarrollador web full stack especializado en React, Node.js y tecnologías modernas. Disponible para proyectos freelance. Landing pages, apps web, e-commerce y desarrollo de APIs."
  keywords="desarrollador web, desarrollador full-stack, desarrollador full stack, React, Node.js, freelance, portafolio, landing pages, aplicaciones web, e-commerce, ecommerce, JavaScript, TypeScript"
>
  <Navbar lang="es" />
  <main>
    <!-- The hero keeps its own glow blobs and floating glyphs, so it stays out
         of the travelling glow's run rather than stacking a second light on
         top of them. Nothing is lost visually: the section right below it is
         opaque (bg-surface-alt), so the glow is hidden there anyway and only
         surfaces once it reaches the first dark section. -->
    <HeroSection lang="es" />
    <TravelingGlow>
      <AboutSection lang="es" />
      <ServicesSection lang="es" />
      <ProjectsSection lang="es" />
      <ReviewsSection lang="es" />
      <ContactSection lang="es" />
    </TravelingGlow>
  </main>
  <Footer lang="es" />
  <!-- ContactDrawer rendered once at root level, opened via CustomEvent -->
  <ContactDrawer client:load lang="es" />
</MainLayout>
