---
import Container from "../layout/Container.astro";
import ProjectCardLink from "../ui/ProjectCardLink.astro";
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/ui";
import { getRouteUrl } from "../../i18n/routes";
import { getProjects } from "../../lib/sanity";

const { lang = "en" } = Astro.props as { lang?: Locale };
const t = useTranslations(lang);

const PROJECTS_TO_SHOW = 6;
const allProjects = await getProjects(lang);
const projects = allProjects.slice(0, PROJECTS_TO_SHOW);
const hasMore = allProjects.length > PROJECTS_TO_SHOW;
const projectsUrl = getRouteUrl(lang, "projects");
---

<section id="projects" class="py-24 bg-surface-alt">
  <Container>
    <div class="mb-14 text-center">
      <p
        class="mb-3 text-sm font-semibold uppercase tracking-widest text-red-400"
        data-scroll-animate="up"
      >
        {t("projects.label")}
      </p>
      <h2
        class="text-3xl font-bold text-slate-100 sm:text-4xl"
        data-scroll-animate="up"
      >
        {t("projects.heading")}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-slate-400" data-scroll-animate="up">
        {t("projects.subtitle")}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, index) => (
          <ProjectCardLink
            project={project}
            lang={lang}
            index={index}
            animate
          />
        ))
      }
    </div>

    {
      hasMore && (
        <div class="mt-12 text-center">
          <a
            href={projectsUrl}
            class="rounded-lg px-8 py-3 font-semibold text-red-400 hover:text-red-500 transition-colors"
            data-scroll-animate="up"
          >
            {t("projects.viewAll")}
          </a>
        </div>
      )
    }

    <!-- CTA -->
    <div class="mt-14 flex flex-col items-center gap-4 text-center">
      <p class="text-slate-400" data-scroll-animate="up">
        {t("projects.cta.text")}
      </p>
      <button
        id="projects-contact-btn"
        data-open-contact
        data-wiggle-trigger
        class="rounded-lg border border-red-600/50 px-6 py-2.5 text-sm font-semibold text-red-400 transition-all hover:border-red-400 hover:text-red-300 cursor-pointer"
        data-scroll-animate="up"
      >
        {t("projects.cta.button")}
      </button>
    </div>
  </Container>
</section>
