---
import Container from "../../layout/Container.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="pb-16 pt-32">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h1
        class="mb-4 text-4xl font-bold leading-tight text-slate-100 sm:text-5xl"
        data-scroll-animate="up"
      >
        {t("projectsOverview.hero.heading")}
      </h1>
      <p
        class="text-lg leading-relaxed text-slate-400"
        data-scroll-animate="up"
      >
        {t("projectsOverview.hero.subheading")}
      </p>
    </div>
  </Container>
</section>
