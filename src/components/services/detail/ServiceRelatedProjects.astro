---
import Container from "../../layout/Container.astro";
import ProjectCardLink from "../../ui/ProjectCardLink.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import type { Service } from "../../../data/services/types";
import { getProjects } from "../../../lib/sanity";

interface Props {
  service: Service;
  lang: Locale;
}

const { service, lang } = Astro.props;
const t = useTranslations(lang);

const allProjects = await getProjects(lang);

const relatedProjects = allProjects
  .filter((project) => project.services?.includes(service.id))
  .slice(0, 3);
---

{
  relatedProjects.length > 0 && (
    <section class="py-20 bg-surface-alt">
      <Container>
        <h2
          class="mb-10 text-center text-3xl font-bold text-slate-100 sm:text-4xl"
          data-scroll-animate="up"
        >
          {t("service.page.related.heading")}
        </h2>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {relatedProjects.map((project, index) => (
            <ProjectCardLink project={project} lang={lang} index={index} />
          ))}
        </div>
      </Container>
    </section>
  )
}
