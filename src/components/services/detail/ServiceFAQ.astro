---
import Container from "../../layout/Container.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import type { Service } from "../../../data/services/types";

interface Props {
  service: Service;
  lang: Locale;
}

const { service, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20">
  <Container>
    <h2 class="mb-10 text-center text-3xl font-bold text-slate-100 sm:text-4xl" data-scroll-animate="up">
      {t("service.page.faq.heading")}
    </h2>

    <div class="mx-auto max-w-2xl space-y-3">
      {
        service.faq.map((item) => (
          <details class="group rounded-xl border border-border bg-surface p-5" data-scroll-animate="up">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-100 marker:content-none">
              {item.question[lang]}
              <svg
                class="h-4 w-4 shrink-0 text-slate-500 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{item.answer[lang]}</p>
          </details>
        ))
      }
    </div>
  </Container>
</section>
