---
import Container from "../../layout/Container.astro";
import Icon from "../../ui/icons.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import type { Service } from "../../../data/services/types";

interface Props {
  service: Service;
  lang: Locale;
}

const { service, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20 bg-surface-alt">
  <Container>
    <h2 class="mb-14 text-center text-3xl font-bold text-slate-100 sm:text-4xl" data-scroll-animate="up">
      {t("service.page.process.heading")}
    </h2>

    <div class="mx-auto grid max-w-5xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        service.process.map((step, index) => (
          <div
            class="relative rounded-2xl border border-border bg-surface p-6"
            data-scroll-animate="up"
          >
            <span class="mb-4 inline-flex h-9 w-9 items-center justify-center rounded-full border border-red-600/40 bg-background text-sm font-semibold text-red-400">
              {index + 1}
            </span>
            <h3 class="mb-2 text-base font-semibold text-slate-100">{step.title[lang]}</h3>
            <p class="text-sm leading-relaxed text-slate-400">{step.description[lang]}</p>
          </div>
        ))
      }
    </div>

    {
      service.processNote && (
        <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-slate-500" data-scroll-animate="up">
          {service.processNote[lang]}
        </p>
      )
    }

    <div class="mx-auto mt-6 max-w-2xl text-center" data-scroll-animate="up">
      <p class="text-sm text-slate-400">{t("service.page.process.cta.question")}</p>
      <a
        href="#service-quote-form"
        class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-red-400 transition-colors hover:text-red-300"
      >
        {t("service.page.process.cta.label")}
        <Icon name="arrowRight" class="h-3.5 w-3.5" />
      </a>
    </div>
  </Container>
</section>
