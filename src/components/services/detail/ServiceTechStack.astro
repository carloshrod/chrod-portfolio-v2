---
import Container from "../../layout/Container.astro";
import SkillBadge from "../../ui/SkillBadge.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import type { Service } from "../../../data/services/types";
import { iconMap, safeColor } from "../../../lib/techIcons";

interface Props {
  service: Service;
  lang: Locale;
}

const { service, lang } = Astro.props;
const t = useTranslations(lang);

const techs = service.techStack;
---

<section class="py-16">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <h2
        class="mb-3 text-2xl font-bold text-slate-100 sm:text-3xl"
        data-scroll-animate="up"
      >
        {t("service.page.techstack.heading")}
      </h2>
      <p class="mb-8 text-sm text-slate-400" data-scroll-animate="up">
        {t("service.page.techstack.intro")}
      </p>
    </div>

    <div
      class="mx-auto flex max-w-3xl flex-wrap justify-center gap-2"
      data-scroll-animate="up"
    >
      {
        techs.map((item) => {
          const icon = iconMap[item];
          return (
            <SkillBadge
              name={item}
              iconPath={icon?.path}
              iconColor={icon ? safeColor(icon.hex) : undefined}
              compact
            />
          );
        })
      }
    </div>
  </Container>
</section>
