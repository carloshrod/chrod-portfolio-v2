---
import Container from "../../layout/Container.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import type { Service } from "../../../data/services/types";

interface Props {
  service: Service;
  lang: Locale;
}

const { service, lang } = Astro.props;
const t = useTranslations(lang);
const { problemSolution } = service;
---

<section class="py-20 bg-surface-alt">
  <Container>
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-bold text-slate-100 sm:text-4xl" data-scroll-animate="up">
        {t("service.page.problem.heading")}
      </h2>
      {
        problemSolution.intro && (
          <p class="mx-auto max-w-2xl text-slate-400 leading-relaxed" data-scroll-animate="up">
            {problemSolution.intro[lang]}
          </p>
        )
      }
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-border bg-surface p-7" data-scroll-animate="right">
        <p class="mb-5 text-sm font-semibold uppercase tracking-widest text-slate-500">
          {t("service.page.problem.label")}
        </p>
        <ul class="space-y-4">
          {
            problemSolution.problems.map((problem) => (
              <li class="flex items-start gap-3 text-slate-400">
                <svg class="mt-1 h-4 w-4 shrink-0 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span>{problem[lang]}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl border border-red-600/30 bg-surface p-7" data-scroll-animate="left">
        <p class="mb-5 text-sm font-semibold uppercase tracking-widest text-red-400">
          {t("service.page.solution.label")}
        </p>
        <ul class="space-y-4">
          {
            problemSolution.solutions.map((solution) => (
              <li class="flex items-start gap-3 text-slate-300">
                <svg class="mt-1 h-4 w-4 shrink-0 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{solution[lang]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>
