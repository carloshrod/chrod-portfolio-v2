---
import Container from "../../layout/Container.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import { getRouteUrl } from "../../../i18n/routes";
import Icons from "../../ui/icons.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const servicesUrl = getRouteUrl(lang, "services");
---

<section class="py-16">
  <Container>
    <div class="mx-auto flex max-w-xl flex-col items-center gap-4 text-center">
      <p class="text-lg text-slate-300" data-scroll-animate="up">
        {t("service.page.exploreMore.heading")}
      </p>
      <a
        href={servicesUrl}
        class="group inline-flex items-center gap-1 px-7 py-3 text-sm font-semibold text-slate-200 transition-all hover:border-red-400 hover:text-red-400"
        data-scroll-animate="up"
      >
        <Icons
          name="arrowLeft"
          class="h-3 w-3 transition-transform duration-300 group-hover:-translate-x-0.5"
        />{" "}
        {t("service.page.backToServices")}
      </a>
    </div>
  </Container>
</section>
