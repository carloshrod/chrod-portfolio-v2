---
import MainLayout from "../../../layouts/MainLayout.astro";
import Navbar from "../../layout/Navbar.astro";
import Footer from "../../layout/Footer.astro";
import ContactDrawer from "../../ui/ContactDrawer.tsx";
import TravelingGlow from "../../ui/TravelingGlow.astro";
import ServicesOverviewHero from "./ServicesOverviewHero.astro";
import ServicesOverviewSelector from "./ServicesOverviewSelector.astro";
import ServicesOverviewGrid from "./ServicesOverviewGrid.astro";
import ServicesOverviewComparison from "./ServicesOverviewComparison.astro";
import ServicesOverviewCTA from "./ServicesOverviewCTA.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import { getAlternatePaths } from "../../../i18n/routes";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = getAlternatePaths("services");
---

<MainLayout
  lang={lang}
  title={t("servicesOverview.seo.title")}
  description={t("servicesOverview.seo.description")}
  alternates={alternates}
>
  <Navbar lang={lang} alternates={alternates} />
  <main>
    <TravelingGlow>
      <ServicesOverviewHero lang={lang} />
      <ServicesOverviewSelector lang={lang} />
      <ServicesOverviewGrid lang={lang} />
      <ServicesOverviewComparison lang={lang} />
      <ServicesOverviewCTA lang={lang} />
    </TravelingGlow>
  </main>
  <Footer lang={lang} />
  <ContactDrawer client:load lang={lang} />
</MainLayout>
