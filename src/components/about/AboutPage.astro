---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../layout/Navbar.astro";
import Footer from "../layout/Footer.astro";
import ContactDrawer from "../ui/ContactDrawer.tsx";
import TravelingGlow from "../ui/TravelingGlow.astro";
import AboutHero from "./AboutHero.astro";
import AboutIntro from "./AboutIntro.astro";
import AboutProcess from "./AboutProcess.astro";
import AboutFocus from "./AboutFocus.astro";
import SkillsSection from "./AboutSkills.astro";
import AboutCTA from "./AboutCTA.astro";
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/ui";
import { getAlternatePaths } from "../../i18n/routes";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = getAlternatePaths("about");
---

<MainLayout
  lang={lang}
  title={t("about.page.seo.title")}
  description={t("about.page.seo.description")}
  alternates={alternates}
>
  <Navbar lang={lang} alternates={alternates} />
  <main>
    <TravelingGlow>
      <AboutHero lang={lang} />
      <AboutIntro lang={lang} />
      <AboutProcess lang={lang} />
      <AboutFocus lang={lang} />
      <SkillsSection lang={lang} />
      <AboutCTA lang={lang} />
    </TravelingGlow>
  </main>
  <Footer lang={lang} />
  <ContactDrawer client:load lang={lang} />
</MainLayout>
