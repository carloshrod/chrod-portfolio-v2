---
import Container from "../layout/Container.astro";
import SkillBadge from "../ui/SkillBadge.astro";
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/ui";
import { iconMap, safeColor } from "../../lib/techIcons";

const { lang = "en" } = Astro.props as { lang?: Locale };
const t = useTranslations(lang);

const skillGroups = [
  {
    category: t("skills.category.frontend"),
    skills: ["React", "Next.js", "Astro", "TypeScript"],
  },
  {
    category: t("skills.category.backend"),
    skills: [
      "Node.js",
      "Express.js",
      "PostgreSQL",
      "MongoDB",
      "Supabase",
      "Firebase",
    ],
  },
  {
    category: t("skills.category.ui"),
    skills: ["Tailwind CSS", "SASS/SCSS", "Ant Design", "Material UI"],
  },
  {
    category: t("skills.category.cms"),
    skills: ["Sanity", "Strapi", "Contentful", "Decap"],
  },
  {
    category: t("skills.category.tools"),
    skills: ["Git", "GitHub", "Docker", "n8n", "Shopify"],
  },
];
---

<section id="skills" class="py-16">
  <Container>
    <div class="mb-14">
      <h2
        class="text-center text-3xl font-bold text-slate-100 sm:text-4xl"
        data-scroll-animate="up"
      >
        {t("skills.heading")}
      </h2>
    </div>

    <div class="space-y-10">
      {
        skillGroups.map((group) => (
          <div data-scroll-animate="left">
            <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-slate-600">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-3">
              {group.skills.map((skill) => {
                const icon = iconMap[skill];
                return (
                  <SkillBadge
                    name={skill}
                    iconPath={icon?.path}
                    iconColor={icon ? safeColor(icon.hex) : undefined}
                  />
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
